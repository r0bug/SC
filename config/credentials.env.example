# Example key=value secrets for SagensContact vault encryption
# Copy to credentials.env, update the values, then run the vault tool to encrypt.

# Communication toggles - set to 'true' to enable real sending, 'false' for mock mode
ENABLE_REAL_SMS=false
ENABLE_REAL_EMAIL=false

DATABASE_URL=sqlite:./data/contacts.db
JWT_SECRET=change-me-use-openssl
WORKER_SECRET=generate-worker-secret
SYNC_SERVICE_URL=http://localhost:3000
SEGMIND_API_KEY=mock-api-key
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=app-specific-password
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=SagensContact
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+15555550100
IMAP_SERVER=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=imap-user
IMAP_PASSWORD=imap-password
CLAMAV_SOCKET_PATH=/var/run/clamav/clamd.ctl
