[database]
url = "sqlite:./data/contacts.db"

[segmind]
api_key = "PLACEHOLDER_SEGMIND_API_KEY"
base_url = "https://api.segmind.com/v1"

[email]
smtp_server = "smtp.example.com"
smtp_port = 587
smtp_user = "placeholder@example.com"
smtp_password = "PLACEHOLDER_PASSWORD"
from_address = "noreply@sagenscontact.local"

[sms]
provider = "mock"  # Options: "mock", "twilio"
# Twilio configuration (when provider = "twilio")
twilio_account_sid = "ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
twilio_auth_token = "your_auth_token_here"
twilio_phone_number = "+1234567890"  # Your Twilio phone number

[social]
twitter_api_key = "PLACEHOLDER_TWITTER_KEY"
twitter_api_secret = "PLACEHOLDER_TWITTER_SECRET"
linkedin_client_id = "PLACEHOLDER_LINKEDIN_ID"
linkedin_client_secret = "PLACEHOLDER_LINKEDIN_SECRET"

[storage]
local_path = "./data/attachments"
minio_endpoint = "http://localhost:9000"
minio_access_key = "minioadmin"
minio_secret_key = "minioadmin"
bucket_name = "sagenscontact"

[sync]
server_url = "http://localhost:3000"
websocket_url = "ws://localhost:3000/ws"