# SagensContact Environment Configuration
# Copy to .env and fill in values

# Required: JWT secret for authentication (generate with: openssl rand -base64 32)
JWT_SECRET=

# Database URL (defaults to sqlite:./data/contacts.db)
DATABASE_URL=sqlite:./data/contacts.db?mode=rwc

# Server bind address (defaults to 0.0.0.0:3000)
BIND_ADDRESS=0.0.0.0:3000

# AI Service (Segmind) - leave empty for mock mode
SEGMIND_API_KEY=

# Virus Scanner (ClamAV)
VIRUS_SCANNER_ENABLED=false
CLAMAV_SOCKET_PATH=/var/run/clamav/clamd.ctl
VIRUS_SCANNER_TIMEOUT=30
VIRUS_SCANNER_STRICT=true

# Logging level
RUST_LOG=info,sync_service=debug

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
