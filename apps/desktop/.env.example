# Segmind AI API Key
# Get your API key from: https://www.segmind.com/
# Leave empty to use mock mode (no real AI calls)
SEGMIND_API_KEY=

# Optional: Custom Segmind base URL (defaults to https://api.segmind.com/v1)
# SEGMIND_BASE_URL=https://api.segmind.com/v1

# Optional: Custom model (defaults to llama-3.1-8b-instruct)
# SEGMIND_MODEL=llama-3.1-8b-instruct
